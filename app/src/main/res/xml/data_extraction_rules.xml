<?xml version="1.0" encoding="utf-8"?>
<!-- Chats, memories and API keys never leave the phone through cloud backup or device-to-device transfer.
     (Keystore-encrypted keys could not be decrypted on another device anyway.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
